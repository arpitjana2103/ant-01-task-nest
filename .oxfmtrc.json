{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [".next", "node_modules", "build", "/components/ui/**"],
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "trailingCommas": "all",
  "singleQuote": true,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "semi": true,
  "sortTailwindcss": true,
  "sortImports": true
}
